---
import TypeIcon from "./TypeIcon.astro";
import { showcase } from "../data/showcase";
import { types } from "../lib/types";

interface Props {
  /** The page being shown: "overview", "showcase" or a type's id. */
  current: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/boccdotdev/data-reveal";
const npm = "https://www.npmjs.com/package/@boccdotdev/data-reveal";
const at = (page: string) => (page === current ? "page" : undefined);
---

<nav class="nav" id="site-nav" aria-label="Site" data-nav-panel transition:persist="site-nav" transition:animate="none">
  <div class="nav-inner">
    <div class="nav-bar">
      <a class="wordmark mono" href={base} translate="no" data-nav>data-reveal</a>
      <div class="nav-buttons mono">
        <button type="button" class="bar-button" aria-expanded="false" aria-controls="settings-pane" data-settings-drawer>
          Settings
        </button>
        <button
          type="button"
          class="bar-button menu-toggle"
          aria-expanded="false"
          aria-controls="nav-menu"
          data-menu-toggle
        >
          Menu
        </button>
      </div>
    </div>
    <div class="nav-menu" id="nav-menu" data-menu>
      <ul class="nav-links mono" role="list">
        <li>
          <a href={base} aria-current={at("overview")} data-nav>
            <svg class="type-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" data-icon="overview">
              <path d="M3 5h2M8 5h9M3 10h2M8 10h9M3 15h2M8 15h9" />
            </svg>
            <span class="nav-text">Overview</span>
          </a>
        </li>
        {
          showcase.length > 0 && (
            <li>
              <a href={`${base}showcase/`} aria-current={at("showcase")} data-nav>
                <svg class="type-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" data-icon="showcase">
                  <path d="M3 4h14v12H3zM3 8h14" />
                </svg>
                <span class="nav-text">Showcase</span>
              </a>
            </li>
          )
        }
      </ul>
      <p class="nav-label mono" id="nav-types">Types</p>
      <ul class="nav-links mono" role="list" aria-labelledby="nav-types" translate="no">
        {
          types.map((type) => (
            <li>
              <a href={`${base}${type.id}/`} aria-current={at(type.id)} data-nav>
                <TypeIcon type={type.id} size={16} />
                <span class="nav-text">{type.id}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="nav-links nav-external mono" role="list">
        <li>
          <a href={repo}>
            <svg class="nav-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            <span class="nav-text">GitHub</span>
          </a>
        </li>
        <li>
          <a href={npm}>
            <svg class="nav-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M0 0v16h16V0H0Zm13 13h-2.5V5.5H8V13H3V3h10v10Z" />
            </svg>
            <span class="nav-text">npm</span>
          </a>
        </li>
      </ul>
      <div class="nav-foot mono">
        <button type="button" class="sound-toggle" role="switch" aria-checked="true" data-sound-toggle>
          <svg class="sound-glyph" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path d="M3 8h3l4-3v10l-4-3H3z" />
            <path class="sound-waves" d="M13 7.5c1 1.5 1 3.5 0 5M15.5 5.5c2 2.7 2 6.3 0 9" />
          </svg>
          <span class="nav-text">Sound</span>
          <span class="sound-state" aria-hidden="true" data-sound-state>on</span>
        </button>
      </div>
    </div>
  </div>
</nav>
