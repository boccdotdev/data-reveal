---
import { ClientRouter } from "astro:transitions";
import "../styles/theme.css";
import mono from "../assets/fonts/JetBrainsMono-Regular.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Off for review pages that aren't for search results. */
  index?: boolean;
}

const { title, description, index = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#282828" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!index && <meta name="robots" content="noindex" />}
    {index && canonical && <link rel="canonical" href={canonical} />}
    {index && <meta property="og:title" content={title} />}
    {index && description && <meta property="og:description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} />
    <!-- General Sans comes from Fontshare: its licence doesn't allow the files in a public repo. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@1&display=swap" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
