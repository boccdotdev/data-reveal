---
// A review sheet for the type icons: every one at three sizes, on light and
// dark, with the second drawing beside those that have one. Not linked from
// the site.
import Site from "../layouts/Site.astro";
import TypeIcon from "../components/TypeIcon.astro";
import { icons } from "../lib/icons";
import { types } from "../lib/types";

const sizes = [16, 20, 32];
const themes = ["light", "dark"] as const;
---

<Site title="Icons · data-reveal" description="The type icons, for review." current="icons" index={false}>
  <header class="page-head">
    <h1>Icons</h1>
    <p class="summary">Each type's icon at 16, 20 and 32 px, on light and dark. Where there's a second drawing, it's in the right-hand column.</p>
  </header>
  <div class="icon-sheet">
    {
      themes.map((theme) => (
        <section class:list={["icon-theme", `icon-theme-${theme}`]} aria-label={`On ${theme}`} data-icon-theme={theme}>
          <p class="mono icon-theme-label">{theme}</p>
          <ul role="list" class="icon-rows">
            {types.map((type) => (
              <li class="icon-row">
                <span class="mono icon-name">{type.id}</span>
                <span class="icon-sizes">
                  {sizes.map((size) => (
                    <TypeIcon type={type.id} size={size} />
                  ))}
                </span>
                <span class="icon-sizes icon-alternate">
                  {icons[type.id].alternate &&
                    sizes.map((size) => <TypeIcon type={type.id} size={size} alternate />)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Site>
